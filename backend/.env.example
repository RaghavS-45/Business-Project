NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/inventory-pos

# JWT Secrets — CHANGE THESE IN PRODUCTION
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# CORS
CORS_ORIGIN=http://localhost:5173

# Cloudinary — Image CDN (get free credentials at cloudinary.com)
# ⚠️  Rotate the API secret immediately if it has ever been committed to git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis — BullMQ job queues
REDIS_URL=redis://localhost:6379

# Store Branding (used on PDF receipts)
STORE_NAME=Inventory POS
STORE_PHONE=
STORE_ADDRESS=

GOOGLE_API_KEY=

# First-run admin seed credentials
# Required on a fresh deployment when no ADMIN user exists in the database.
# Set both vars, start the server once, then REMOVE or ROTATE the password.
# The server will refuse to start in production if no ADMIN exists and these are unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=
